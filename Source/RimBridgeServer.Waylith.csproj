<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RimBridgeServer</AssemblyName>
    <Version>$(ModVersion)</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>../artifacts/waylith/compiled/</OutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs;../Tools/WaylithReference/GameAccess.cs" />
    <Reference Include="../1.6/Assemblies/*.dll" Exclude="../1.6/Assemblies/RimBridgeServer.dll" />
    <Reference Include="Assembly-CSharp" HintPath="$(WaylithReferencePath)" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(GamePath)/UnityStubs.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(HarmonyPath)" Private="false" />
  </ItemGroup>
</Project>

